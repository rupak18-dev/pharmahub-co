# Server
PORT=5000
# Public origin of the web app — used to build invitation & reset-password links.
# Defaults to the Vite dev server port (5100).
# FRONTEND_URL=http://localhost:5100
NODE_ENV=development

# MongoDB — REQUIRED. There is deliberately NO localhost fallback: the server
# refuses to start if MONGO_URL is missing, so it can never silently connect to
# a local database. Production uses MongoDB Atlas:
#   MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pharmahub?retryWrites=true&w=majority
# MONGO_URI is accepted as a legacy alias only.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pharmahub?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - use comma-separated list or * for all
CORS_ORIGIN=*

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Password reset links (ms)
# PASSWORD_RESET_TTL_MS=3600000

# SMTP — required for scheduled report emails, staff invitations and password
# reset emails. SMTP_PASSWORD is an alias for SMTP_PASS.
# Use the PharmaHub business Gmail account with a Gmail App Password.
# NEVER commit the real App Password — only the placeholder below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=pharmahub.team@gmail.com
SMTP_PASSWORD=
MAIL_FROM=pharmahub.team@gmail.com
FRONTEND_URL=http://localhost:5100

# Google OAuth — required for the organization-level Gmail integration
# (send invoices / reports / notifications from the pharmacy's own Gmail).
# Create an OAuth 2.0 Client ID of type "Web application":
#   https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI.
# Scope used: https://www.googleapis.com/auth/gmail.send (send-only — the
# integration never reads or modifies the mailbox).
# If GOOGLE_REDIRECT_URI is left unset it defaults to this server's own
# Gmail callback: http://localhost:5050/api/v1/integrations/gmail/callback
# NEVER commit the real client secret — only the placeholder below.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5050/api/v1/integrations/gmail/callback

# WhatsApp Business Cloud API — enables delivering customer bills (Reports →
# Bills) to the customer's WhatsApp number. These are the shared Meta Graph API
# credentials; the org's business phone number itself is entered by the admin
# under Profile → Integrations → WhatsApp Business.
#   WHATSAPP_PHONE_NUMBER_ID and WHATSAPP_ACCESS_TOKEN are REQUIRED to actually
#   send messages. Without them a connected integration is treated as unusable
#   and bills are saved without delivery (never faked as "Sent").
# Get both from Meta's WhatsApp Business Platform (Graph API):
#   https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# Optional: an approved template name (e.g. "pharmahub_bill") used for
# business-initiated messages. If left empty the integration sends a media
# message with the actual invoice attached instead.
# NEVER commit the real access token — only the placeholder below.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BILL_TEMPLATE_NAME=
# WHATSAPP_BILL_TEMPLATE_LANG=en
# WHATSAPP_GRAPH_VERSION=v21.0
# Public base URL of this API — used to build media links Meta can download
# the bill from. In production this must be reachable by Meta (no localhost).
# API_PUBLIC_URL=http://localhost:5050
# CURRENCY_SYMBOL=₹

